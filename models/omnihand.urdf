<?xml version="1.0" encoding="utf-8"?>
<!-- ========================================================================= -->
<!-- FIGURE AI // PROJECT TACTILE-V : OMNIHAND DEXTEROUS SUBSYSTEM URDF        -->
<!-- 20-DoF Active Humanoid Hand & Forearm with Integrated Tactile Array Sites -->
<!-- ========================================================================= -->
<robot name="figure_omnihand_tactile_v">

  <!-- Base Forearm Housing -->
  <link name="forearm_base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.420"/>
      <inertia ixx="0.00142" ixy="0" ixz="0" iyy="0.00142" iyz="0" izz="0.00038"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.36"/>
      </geometry>
      <material name="carbon_dark">
        <color rgba="0.12 0.13 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.36"/>
      </geometry>
    </collision>
  </link>

  <!-- Wrist Pitch -->
  <link name="wrist_pitch_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.045"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="titanium_silver">
        <color rgba="0.75 0.78 0.82 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="forearm_base_link"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0 0 0.19" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.785" upper="0.785" effort="18.0" velocity="4.5"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <!-- Palm / Chassis -->
  <link name="palm_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.180"/>
      <inertia ixx="0.00021" ixy="0" ixz="0" iyy="0.00018" iyz="0" izz="0.00015"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.084 0.036 0.090"/>
      </geometry>
      <material name="carbon_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.084 0.036 0.090"/>
      </geometry>
    </collision>
  </link>

  <joint name="wrist_yaw_joint" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="palm_link"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.523" upper="0.523" effort="15.0" velocity="4.5"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <!-- ========================================================== -->
  <!-- INDEX FINGER CHAIN                                         -->
  <!-- ========================================================== -->
  <link name="index_proximal_link">
    <inertial>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
      <mass value="0.024"/>
      <inertia ixx="0.000004" ixy="0" ixz="0" iyy="0.000004" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.044"/>
      </geometry>
      <material name="carbon_dark"/>
    </visual>
  </link>

  <joint name="index_mcp_joint" type="revolute">
    <parent link="palm_link"/>
    <child link="index_proximal_link"/>
    <origin xyz="-0.028 0.002 0.065" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.1" upper="1.57" effort="10.0" velocity="6.0"/>
  </joint>

  <link name="index_distal_link">
    <inertial>
      <origin xyz="0 0 0.016" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.016" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.032"/>
      </geometry>
      <material name="carbon_dark"/>
    </visual>
  </link>

  <joint name="index_pip_joint" type="revolute">
    <parent link="index_proximal_link"/>
    <child link="index_distal_link"/>
    <origin xyz="0 0 0.044" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.6" effort="8.0" velocity="6.0"/>
  </joint>

  <!-- Index Fingertip Tactile Sensor Link -->
  <link name="index_tactile_sensor">
    <visual>
      <geometry>
        <sphere radius="0.0085"/>
      </geometry>
      <material name="tactile_cyan">
        <color rgba="0.0 0.94 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="index_sensor_fixed" type="fixed">
    <parent link="index_distal_link"/>
    <child link="index_tactile_sensor"/>
    <origin xyz="0 0.005 0.032" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================== -->
  <!-- THUMB OPPOSITION CHAIN                                     -->
  <!-- ========================================================== -->
  <link name="thumb_proximal_link">
    <inertial>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.010" length="0.040"/>
      </geometry>
      <material name="titanium_silver"/>
    </visual>
  </link>

  <joint name="thumb_oppose_joint" type="revolute">
    <parent link="palm_link"/>
    <child link="thumb_proximal_link"/>
    <origin xyz="-0.035 0.01 0.01" rpy="0.785 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.2" upper="1.57" effort="12.0" velocity="5.0"/>
  </joint>

  <link name="thumb_distal_link">
    <inertial>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <mass value="0.018"/>
      <inertia ixx="0.000003" ixy="0" ixz="0" iyy="0.000003" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.035"/>
      </geometry>
      <material name="carbon_dark"/>
    </visual>
  </link>

  <joint name="thumb_flex_joint" type="revolute">
    <parent link="thumb_proximal_link"/>
    <child link="thumb_distal_link"/>
    <origin xyz="0 0 0.040" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.5" effort="10.0" velocity="5.0"/>
  </joint>

  <!-- Thumb Tactile Sensor Link -->
  <link name="thumb_tactile_sensor">
    <visual>
      <geometry>
        <sphere radius="0.010"/>
      </geometry>
      <material name="tactile_cyan"/>
    </visual>
  </link>

  <joint name="thumb_sensor_fixed" type="fixed">
    <parent link="thumb_distal_link"/>
    <child link="thumb_tactile_sensor"/>
    <origin xyz="0 0.006 0.035" rpy="0 0 0"/>
  </joint>

</robot>
